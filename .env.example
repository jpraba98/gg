# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://thedriproom6ix.com

# ── YouTube Data API v3 (Media page + home page video preview) ──────
# Create a key at https://console.cloud.google.com/apis/credentials
# and enable "YouTube Data API v3".
YOUTUBE_API_KEY=
# Channel to pull videos from — defaults to thedriproom6ix if unset.
YOUTUBE_CHANNEL_HANDLE=thedriproom6ix

# ── Eventbrite ────────────────────────────────────────────────────────
# Not required for launch — event pages link out to Eventbrite URLs
# directly (see src/data/events.ts). Reserved for a future live
# ticket-inventory sync.
EVENTBRITE_API_KEY=

# ── Supabase (auth + members database) ──────────────────────────────
# Create a project at https://supabase.com, then copy these from
# Project Settings → API. Required for the Members Portal auth flows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, elevated-privilege key — never expose to the client.
# Reserved for future admin-side member management (e.g. syncing
# membership status/expiry from Stripe webhooks).
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (DR Member checkout — card, Apple Pay, and PayPal via Stripe) ─
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Publishable key, used client-side if you add Stripe Elements later
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring Price IDs for the DR Member tier (Products → Pricing in Stripe)
STRIPE_PRICE_DR_MEMBER_MONTHLY=
STRIPE_PRICE_DR_MEMBER_YEARLY=

# ── Email notifications (booking + sponsor inquiry forms) ───────────
# Create a key at https://resend.com/api-keys. Without this set, form
# submissions are logged to the server console instead of emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL="TheDripRoom6ix <onboarding@resend.dev>"
# Inbox that booking/sponsor inquiries are sent to. Defaults to
# 416mediacompany@gmail.com (see src/lib/site-config.ts) if unset.
CONTACT_EMAIL=416mediacompany@gmail.com
