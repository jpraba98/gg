# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://thedriproom6ix.com

# ── YouTube Data API v3 (Media page video grid) ──────────────────────
# Create a key at https://console.cloud.google.com/apis/credentials
# and enable "YouTube Data API v3".
YOUTUBE_API_KEY=
# Channel to pull videos from — defaults to thedriproom6ix if unset.
YOUTUBE_CHANNEL_HANDLE=thedriproom6ix

# ── Instagram Graph API (Media page — Instagram Feed tab) ───────────
# Requires @thedriproom6ix to be connected to a Facebook Business
# account. Without these set, the Instagram Feed tab falls back to
# placeholder posts — see the TODO in src/app/api/instagram/route.ts.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── Eventbrite ────────────────────────────────────────────────────────
# Not required for launch — event pages link out to Eventbrite URLs
# directly (see src/data/events.ts). Reserved for a future live
# ticket-inventory sync.
EVENTBRITE_API_KEY=

# ── Supabase (accounts, articles, comments, likes, applications) ────
# Create a project at https://supabase.com, run supabase/schema.sql
# once in the SQL Editor, then copy these from Project Settings → API.
# See supabase/README.md for the full setup walkthrough. Required for
# sign up/login, the member & staff dashboards, comments, likes, the
# blog CMS, and team applications.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, elevated-privilege key — never expose to the client.
# Not currently read by any route (RLS handles authorization instead);
# kept for future admin tooling that needs to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Member checkout — card, Apple Pay, and PayPal via Stripe) ─
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Publishable key, used client-side if you add Stripe Elements later
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring Price IDs for the TheDripRoom6ix Member tier (Products → Pricing in Stripe)
STRIPE_PRICE_DR_MEMBER_MONTHLY=
STRIPE_PRICE_DR_MEMBER_YEARLY=

# ── Email notifications (booking inquiries + team applications) ─────
# Create a key at https://resend.com/api-keys. Without this set, form
# submissions are logged to the server console instead of emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL="TheDripRoom6ix <onboarding@resend.dev>"
# Inbox that booking inquiries and team applications are sent to.
# Defaults to 416mediacompany@gmail.com (see src/lib/site-config.ts) if unset.
CONTACT_EMAIL=416mediacompany@gmail.com
